# Port konfiguracji Wallabag na hoście
WALLABAG_PORT=8088

# Nazwa domeny/URL (kluczowe dla prawidłowego generowania assetów i linków)
# Np. http://localhost:8088 lub https://wallabag.twojadomena.pl
WALLABAG_DOMAIN_NAME=http://localhost:8088
WALLABAG_SERVER_NAME="Wallabag Homelab"

# Losowy klucz sekretny Symfony (np. wygeneruj: openssl rand -hex 32)
WALLABAG_SECRET=change_me_to_a_random_32_character_secret_string

# Zezwolenie na rejestrację nowych kont (true / false)
WALLABAG_REGISTRATION=false

# Konfiguracja bazy danych MariaDB
MYSQL_DATABASE=wallabag
MYSQL_USER=wallabag
MYSQL_PASSWORD=twoje_bezpieczne_haslo_uzytkownika
MYSQL_ROOT_PASSWORD=twoje_bezpieczne_haslo_root
